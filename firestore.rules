rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms collection
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if true;
      allow write: if true;
    }

    // Mail queue collection for Firebase Trigger Email Extension or backend mailer
    match /mail/{mailId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Email Notifications collection
    match /emailNotifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // System settings
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
