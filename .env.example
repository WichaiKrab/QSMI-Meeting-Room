# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides for Vercel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SMTP Email Configuration (For Vercel Serverless Email Sending with personal Gmail or corporate SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM="ระบบจองห้องประชุม สถานเสาวภา" <your_email@gmail.com>
